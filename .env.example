# --- Frontend (Vite) ---------------------------------------------------------
# Google Maps JavaScript API key. Required for the risk map + heatmap.
# Enable "Maps JavaScript API" and the Visualization library in Google Cloud.
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Optional: FastAPI pipeline base URL. When empty the app runs fully offline
# and ingests uploaded footage in the browser.
VITE_API_BASE_URL=http://localhost:8000
